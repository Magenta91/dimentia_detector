# Backend Environment Variables
# Copy this file to .env for local development or configure in your hosting platform

# Server Configuration
NODE_ENV=development
PORT=3001

# MongoDB Atlas Connection
# Get this from MongoDB Atlas: Clusters > Connect > Connect your application
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# Authentication
# Generate a secure random string (32+ characters) for production
JWT_SECRET=your_secure_jwt_secret_change_in_production

# CORS Configuration
# Development: http://localhost:5173,http://127.0.0.1:5173
# Production: https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Demo Mode (optional)
MINDSCAN_DEMO_MODE=false

# Python Executable (optional - auto-detected if not set)
# Windows: C:\path\to\python.exe
# Linux/Mac: /usr/bin/python3 or python3
PYTHON_EXECUTABLE=

# AI Model Configuration (optional - leave empty if no models available)
MINDSCAN_MODEL_DIR=
MINDSCAN_MODEL_VERSION=
MINDSCAN_MODEL_NAME=logistic_regression

# Audio Model Configuration (optional - leave empty if no models available)
MINDSCAN_AUDIO_MODEL_DIR=
MINDSCAN_AUDIO_MODEL_VERSION=
MINDSCAN_AUDIO_MODEL_NAME=logistic_regression
MINDSCAN_AUDIO_MODEL_PYTHON=
